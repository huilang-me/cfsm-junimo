{
  "name": "cfsm-junimo",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "description": "CF-Server-Monitor theme",
  "author": "Planck",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:github-page": "tsc -b && vite build --base ./ && node scripts/build-github-page.js",
